config singbox_core 'main'
	option enabled '1'
	option log_level 'info'

config node 'node'
	option protocol 'hysteria2'
	option server ''
	option server_port '443'
	option password ''
	option sni ''
	option insecure '0'
	option obfs ''
	option obfs_password ''
	option uuid ''
	option congestion_control 'bbr'
	option udp_relay_mode 'native'

config dns 'dns'
	option bootstrap '223.5.5.5'
	option cn_server '223.5.5.5'
	option cn_path '/dns-query'
	option remote_server 'dns.google'
	option remote_path '/dns-query'
	option cache_capacity '4096'
	option optimistic '1'
	option strategy 'prefer_ipv4'
	list remote_categories 'google'
	list remote_categories 'github'

config route 'route'
	option auto_redirect '1'
	option block_quic '1'
	option block_ads '1'
	option bypass_cn '1'
	option tun_mtu '1400'
	option tun_table '2023'
	option tun_rule '9100'
	option tun_address '172.19.0.1/30'
	option bypass_process 'dnsmasq,zerotier-one'
	option dns_hijack_exempt_process 'kixdns,oxidns'
	option forced_proxy_process 'hev-socks5-serve'
	option forced_proxy_target '8.8.8.8,8.8.4.4'
	option lan_mac ''
	option dhcp_lease_file '/tmp/dhcp.leases'
