{
	"luci-app-sing-box-core": {
		"description": "Grant access to the sing-box-core sing-box panel",
		"read": {
			"ubus": {
				"service": [ "list" ],
				"uci": [ "get", "state" ]
			},
			"uci": [ "singbox_core" ],
			"file": {
				"/usr/libexec/sing-box-core/render.uc": [ "exec" ],
				"/usr/libexec/sing-box-core/sing-box": [ "exec" ],
				"/var/run/sing-box-core/config.json": [ "read" ],
				"/var/log/sing-box-core-check.log": [ "read" ],
				"/sbin/logread": [ "exec" ]
			}
		},
		"write": {
			"uci": [ "singbox_core" ],
			"file": {
				"/usr/libexec/sing-box-core/apply.sh": [ "exec" ],
				"/etc/init.d/sing-box-core": [ "exec" ]
			}
		}
	}
}
