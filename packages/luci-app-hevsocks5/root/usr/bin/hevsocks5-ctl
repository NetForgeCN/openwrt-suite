#!/bin/sh
# hevsocks5-ctl - UCI to YAML renderer and service helper for luci-app-hevsocks5
# This file is part of NetForgeCN/luci-app-hevsocks5 (MIT).

CONF='hev-socks5-server'
SECTION='config'
INIT='/etc/init.d/hev-socks5-server'
DEFAULT_CONFFILE='/etc/hev-socks5-server/main.yml'

die() {
	echo "hevsocks5-ctl: $*" >&2
	exit 1
}

get() {
	uci -q get "$CONF.$SECTION.$1" 2>/dev/null
}

val() {
	local v
	v="$(get "$1")"
	[ -n "$v" ] || v="$2"
	printf '%s' "$v"
}

is_uint() {
	case "$1" in
		''|*[!0-9]*) return 1 ;;
		*) return 0 ;;
	esac
}

is_true() {
	case "$1" in
		1|true|yes|on) return 0 ;;
		*) return 1 ;;
	esac
}

check_uint() {
	is_uint "$2" || die "$1 must be an integer"
}

valid_udp_port() {
	local p="$1" beg end

	[ -n "$p" ] || return 0

	case "$p" in
		*-*)
			beg="${p%%-*}"
			end="${p#*-}"
			is_uint "$beg" && is_uint "$end" || return 1
			[ "$beg" -ge 1 ] 2>/dev/null && [ "$beg" -le 65535 ] 2>/dev/null || return 1
			[ "$end" -ge 1 ] 2>/dev/null && [ "$end" -le 65535 ] 2>/dev/null || return 1
			[ "$beg" -le "$end" ] 2>/dev/null || return 1
			;;
		*)
			is_uint "$p" || return 1
			[ "$p" -ge 1 ] 2>/dev/null && [ "$p" -le 65535 ] 2>/dev/null || return 1
			;;
	esac

	return 0
}

yaml_str() {
	printf "'%s'" "$(printf '%s' "$1" | sed "s/'/''/g")"
}

generate() {
	local conffile tmpdir tmp
	local workers port listen_address udp_port udp_listen_address
	local udp_public_address_v4 udp_public_address_v6 listen_ipv6_only
	local bind_address bind_address_v4 bind_address_v6 bind_interface
	local domain_address_type mark tcp_fastopen
	local auth_file username password allow_no_auth
	local task_stack_size udp_recv_buffer_size udp_copy_buffer_nums
	local connect_timeout tcp_rw_timeout udp_rw_timeout legacy_rw_timeout
	local log_file log_level limit_nofile

	conffile="$(val conffile "$DEFAULT_CONFFILE")"
	[ -n "$conffile" ] || die 'conffile is empty'

	workers="$(val workers 4)"
	port="$(val port 1080)"
	listen_address="$(val listen_address '::')"
	udp_port="$(get udp_port)"
	udp_listen_address="$(get udp_listen_address)"
	udp_public_address_v4="$(get udp_public_address_v4)"
	udp_public_address_v6="$(get udp_public_address_v6)"
	listen_ipv6_only="$(val listen_ipv6_only 0)"
	bind_address="$(get bind_address)"
	bind_address_v4="$(get bind_address_v4)"
	bind_address_v6="$(get bind_address_v6)"
	bind_interface="$(get bind_interface)"
	domain_address_type="$(val domain_address_type unspec)"
	mark="$(val mark 0)"
	tcp_fastopen="$(val tcp_fastopen 0)"

	auth_file="$(get auth_file)"
	username="$(get username)"
	password="$(get password)"
	allow_no_auth="$(val allow_no_auth 0)"

	task_stack_size="$(val task_stack_size 8192)"
	udp_recv_buffer_size="$(val udp_recv_buffer_size 524288)"
	udp_copy_buffer_nums="$(val udp_copy_buffer_nums 10)"
	connect_timeout="$(val connect_timeout 10000)"
	tcp_rw_timeout="$(val tcp_read_write_timeout 300000)"
	udp_rw_timeout="$(val udp_read_write_timeout 60000)"
	legacy_rw_timeout="$(get read_write_timeout)"
	log_file="$(get log_file)"
	log_level="$(val log_level warn)"
	limit_nofile="$(val limit_nofile 1000000)"

	is_uint "$workers" || die 'workers must be an integer'
	[ "$workers" -ge 1 ] 2>/dev/null || die 'workers must be at least 1'
	is_uint "$port" || die 'port must be an integer'
	[ "$port" -ge 1 ] 2>/dev/null && [ "$port" -le 65535 ] 2>/dev/null || die 'port must be between 1 and 65535'
	[ -n "$listen_address" ] || die 'listen-address must not be empty'
	if [ -n "$udp_port" ]; then
		valid_udp_port "$udp_port" || die 'udp-port must be a port (1-65535) or a range like 10000-20000'
	fi
	printf '%s' "$mark" | grep -Eq '^(0[xX][0-9A-Fa-f]+|[0-9]+)$' || die 'mark must be decimal, hex (0x..) or octal (0..)'
	case "$domain_address_type" in
		unspec|ipv4|ipv6) ;;
		*) die 'domain-address-type must be unspec, ipv4 or ipv6' ;;
	esac
	case "$log_level" in
		debug|info|warn|error) ;;
		*) die 'log-level must be debug, info, warn or error' ;;
	esac
	check_uint 'task-stack-size' "$task_stack_size"
	check_uint 'udp-recv-buffer-size' "$udp_recv_buffer_size"
	check_uint 'udp-copy-buffer-nums' "$udp_copy_buffer_nums"
	check_uint 'connect-timeout' "$connect_timeout"
	check_uint 'tcp-read-write-timeout' "$tcp_rw_timeout"
	check_uint 'udp-read-write-timeout' "$udp_rw_timeout"
	check_uint 'limit-nofile' "$limit_nofile"
	if [ -n "$legacy_rw_timeout" ]; then
		check_uint 'read-write-timeout' "$legacy_rw_timeout"
	fi

	if [ -z "$auth_file" ] && { [ -z "$username" ] || [ -z "$password" ]; }; then
		is_true "$allow_no_auth" || die 'username/password are empty: set both, set auth_file, or enable allow-no-auth explicitly'
	fi

	tmpdir="$(dirname "$conffile")"
	mkdir -p "$tmpdir" || die "cannot create $tmpdir"
	tmp="$conffile.tmp.$$"
	trap 'rm -f "$tmp"' EXIT HUP INT TERM

	{
		echo '# Generated by luci-app-hevsocks5 - do not edit by hand.'
		echo '# Source: /etc/config/hev-socks5-server'
		echo 'main:'
		echo "  workers: $workers"
		echo "  port: $port"
		echo "  listen-address: $(yaml_str "$listen_address")"
		[ -n "$udp_port" ] && echo "  udp-port: $(yaml_str "$udp_port")"
		[ -n "$udp_listen_address" ] && echo "  udp-listen-address: $(yaml_str "$udp_listen_address")"
		[ -n "$udp_public_address_v4" ] && echo "  udp-public-address-v4: $(yaml_str "$udp_public_address_v4")"
		[ -n "$udp_public_address_v6" ] && echo "  udp-public-address-v6: $(yaml_str "$udp_public_address_v6")"
		if is_true "$listen_ipv6_only"; then echo '  listen-ipv6-only: true'; else echo '  listen-ipv6-only: false'; fi
		[ -n "$bind_address" ] && echo "  bind-address: $(yaml_str "$bind_address")"
		[ -n "$bind_address_v4" ] && echo "  bind-address-v4: $(yaml_str "$bind_address_v4")"
		[ -n "$bind_address_v6" ] && echo "  bind-address-v6: $(yaml_str "$bind_address_v6")"
		[ -n "$bind_interface" ] && echo "  bind-interface: $(yaml_str "$bind_interface")"
		echo "  domain-address-type: $(yaml_str "$domain_address_type")"
		echo "  mark: $(yaml_str "$mark")"
		if is_true "$tcp_fastopen"; then echo '  tcp-fastopen: true'; else echo '  tcp-fastopen: false'; fi

		if [ -n "$auth_file" ]; then
			echo 'auth:'
			echo "  file: $(yaml_str "$auth_file")"
		elif [ -n "$username" ] && [ -n "$password" ]; then
			echo 'auth:'
			echo "  username: $(yaml_str "$username")"
			echo "  password: $(yaml_str "$password")"
		fi

		echo 'misc:'
		echo "  task-stack-size: $task_stack_size"
		echo "  udp-recv-buffer-size: $udp_recv_buffer_size"
		echo "  udp-copy-buffer-nums: $udp_copy_buffer_nums"
		echo "  connect-timeout: $connect_timeout"
		if [ -n "$legacy_rw_timeout" ]; then
			echo "  read-write-timeout: $legacy_rw_timeout"
		else
			echo "  tcp-read-write-timeout: $tcp_rw_timeout"
			echo "  udp-read-write-timeout: $udp_rw_timeout"
		fi
		if [ -n "$log_file" ]; then
			echo "  log-file: $(yaml_str "$log_file")"
		else
			echo '  log-file: null'
		fi
		echo "  log-level: $(yaml_str "$log_level")"
		# pid-file is deliberately omitted: calling daemon() would detach from procd.
		echo '  # pid-file is managed by procd and is never generated here'
		echo "  limit-nofile: $limit_nofile"
	} > "$tmp" || die 'failed to write generated config'

	chmod 600 "$tmp" || die 'failed to set config permissions'
	mv -f "$tmp" "$conffile" || die "failed to replace $conffile"
	trap - EXIT HUP INT TERM
	echo "Config generated: $conffile"
}

apply_config() {
	generate
	local enabled
	enabled="$(val enabled 0)"
	if is_true "$enabled"; then
		"$INIT" enable >/dev/null 2>&1 || :
		"$INIT" restart || die 'failed to restart hev-socks5-server'
	else
		"$INIT" disable >/dev/null 2>&1 || :
		"$INIT" stop >/dev/null 2>&1 || :
	fi
}

case "$1" in
	generate) generate ;;
	apply) apply_config ;;
	start|stop|restart|enable|disable|status)
		exec "$INIT" "$1"
		;;
	*)
		echo "Usage: $0 {generate|apply|start|stop|restart|enable|disable|status}" >&2
		exit 1
		;;
esac
