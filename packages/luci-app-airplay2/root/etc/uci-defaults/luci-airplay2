#!/bin/sh

if [ -f "/etc/config/ucitrack" ]; then
	if ! uci -q batch <<-EOF >/dev/null
		delete ucitrack.@airplay2[-1]
		add ucitrack airplay2
		set ucitrack.@airplay2[-1].init=airplay2
		commit ucitrack
EOF
	then
		logger -t luci-airplay2 -p daemon.warn "failed to register the ucitrack entry"
	fi
fi

rm -rf /tmp/luci-indexcache* 2>/dev/null || \
	logger -t luci-airplay2 -p daemon.warn "failed to clear LuCI caches"

exit 0
