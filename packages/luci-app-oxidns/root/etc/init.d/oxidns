#!/bin/sh /etc/rc.common

USE_PROCD=1
START=90
STOP=10

PROG="/usr/bin/oxidns"
DEFAULT_CONFIG_PATH="/etc/oxidns/config.yaml"
DEFAULT_WORKING_DIR="/var/lib/oxidns"
PERSIST_DIR="/etc/oxidns/core"
PERSIST_BIN="$PERSIST_DIR/oxidns"
PERSIST_WEBUI="$PERSIST_DIR/webui"
WEBUI_DIR="/usr/share/oxidns/webui"

load_oxidns_settings() {
	config_load oxidns
	config_get CONFIG_PATH main config_path "$DEFAULT_CONFIG_PATH"
	config_get WORKING_DIR main working_dir "$DEFAULT_WORKING_DIR"
	config_get_bool LOG_SYSLOG main log_syslog 1
}

# Boot self-heal: the persistent copy of the core survives firmware upgrades
# (via /etc/sysupgrade.conf). Recreate the runtime symlinks when they are
# missing or dangling, so a reinstall of the LuCI package after an upgrade is
# enough to bring the DNS service back without re-downloading anything.
restore_core_links() {
	if [ -x "$PERSIST_BIN" ]; then
		if [ ! -x "$PROG" ]; then
			mkdir -p "$(dirname "$PROG")"
			ln -sf "$PERSIST_BIN" "$PROG"
		fi
	fi
	if [ -d "$PERSIST_WEBUI" ]; then
		if [ ! -d "$WEBUI_DIR" ]; then
			mkdir -p "$(dirname "$WEBUI_DIR")"
			ln -sfn "$PERSIST_WEBUI" "$WEBUI_DIR"
		fi
	fi
}

start_service() {
	load_oxidns_settings
	restore_core_links

	if [ ! -x "$PROG" ]; then
		echo "oxidns binary not found or not executable: $PROG" >&2
		return 1
	fi
	if [ ! -r "$CONFIG_PATH" ]; then
		echo "oxidns config not found: $CONFIG_PATH" >&2
		return 1
	fi

	mkdir -p "$WORKING_DIR"

	procd_open_instance
	procd_set_param command "$PROG" start -c "$CONFIG_PATH" -d "$WORKING_DIR"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout "$LOG_SYSLOG"
	procd_set_param stderr "$LOG_SYSLOG"
	procd_close_instance
}

reload_service() {
	procd_send_signal oxidns
}

service_triggers() {
	procd_add_reload_trigger oxidns
}
