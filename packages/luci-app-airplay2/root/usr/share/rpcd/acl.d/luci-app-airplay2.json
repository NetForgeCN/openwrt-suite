{
	"luci-app-airplay2": {
		"description": "Grant UCI access for luci-app-airplay2",
		"read": {
			"file": {
				"/proc/asound/cards": [ "read" ],
				"/usr/bin/bluealsa-aplay": [ "stat" ],
				"/usr/bin/bluealsa-aplay -l": [ "exec" ]
			},
			"ubus": {
				"file": [ "read", "stat", "exec" ],
				"service": [ "list" ]
			},
			"uci": [ "airplay2" ]
		},
		"write": {
			"uci": [ "airplay2" ]
		}
	}
}
