#!/bin/sh
# Copyright (C) 2026 NetForgeCN - GPL-3.0-or-later
#
# rpcd methods for the OxiDNS Plus LuCI page. All operations target this
# add-on's own UCI package, watch list, status file and log. config.yaml is
# never modified.

STATUS_FILE=/tmp/oxidnsplus.status.json
WATCH_LIST="$(uci -q get oxidnsplus.main.watch_list 2>/dev/null)"
[ -n "$WATCH_LIST" ] || WATCH_LIST=/etc/oxidnsplus/watch.list

# POSIX-sh JSON string escaping (busybox ash has no ${var//x/y} substitution).
# Uses awk so newlines/tabs are handled without GNU-only sed multiline tricks.
json_string() {
	printf '"'
	printf '%s' "$1" | awk 'BEGIN{ORS=""} {
		gsub(/\\/, "\\\\"); gsub(/"/, "\\\"");
		gsub(/\t/, "\\t"); gsub(/\r/, "\\r");
		if (NR > 1) printf "\\n";
		print;
	}'
	printf '"'
}

input_value() {
	local key="$1" input="$2"
	printf '%s' "$input" | jsonfilter -e "@['$key']" 2>/dev/null || printf ''
}

FIELDS="enabled config_path api_base api_user api_pass cache_tag dns_target watch_list mode tick grace refresh_delay min_ttl min_interval max_interval jitter retry_base retry_max retry_max_count log_level"

uci_get() { uci -q get "oxidnsplus.main.$1" 2>/dev/null || printf ''; }

emit_settings_read() {
	printf '{"ok":true,'
	first=1
	for f in $FIELDS; do
		[ $first -eq 1 ] || printf ','
		first=0
		v="$(uci_get "$f")"
		# Never expose the API password to the browser.
		[ "$f" = "api_pass" ] && v=""
		printf '"%s":' "$f"
		if [ "$f" = "api_pass" ]; then
			if [ -n "$(uci_get api_pass)" ]; then printf '"********"'; else printf '""'; fi
		elif [ "$f" = "enabled" ]; then
			[ "$v" = "1" ] && printf 'true' || printf 'false'
		else
			json_string "$v"
		fi
	done
	printf '}\n'
}

emit_settings_save() {
	INPUT="$(cat)"
	for f in $FIELDS; do
		[ "$f" = "enabled" ] && continue
		v="$(input_value "$f" "$INPUT")"
		# Keep a masked password unchanged.
		if [ "$f" = "api_pass" ] && [ "$v" = "********" ]; then continue; fi
		uci -q set "oxidnsplus.main.$f=$v"
	done
	en="$(input_value enabled "$INPUT")"
	if [ -n "$en" ]; then
		if [ "$en" = "true" ] || [ "$en" = "1" ]; then uci -q set oxidnsplus.main.enabled=1
		else uci -q set oxidnsplus.main.enabled=0; fi
	fi
	uci -q commit oxidnsplus
	[ -x /etc/init.d/oxidnsplus ] && /etc/init.d/oxidnsplus restart >/dev/null 2>&1 || true
	printf '{"ok":true,"message":'$(json_string "Settings saved; prewarmer restarted.")'}\n'
}

emit_status() {
	if [ -r "$STATUS_FILE" ]; then
		printf '{"ok":true,"status":'
		cat "$STATUS_FILE"
		printf '}\n'
	else
		printf '{"ok":false,"error":"no status file","hint":"is the prewarmer running?"}\n'
	fi
}

emit_warm_list_read() {
	if [ -r "$WATCH_LIST" ]; then
		printf '{"ok":true,"content":'
		json_string "$(cat "$WATCH_LIST")"
		printf '}\n'
	else
		printf '{"ok":false,"error":"watch list not found"}\n'
	fi
}

emit_warm_list_save() {
	INPUT="$(cat)"
	content="$(input_value content "$INPUT")"
	mkdir -p "$(dirname "$WATCH_LIST")"
	printf '%s\n' "$content" > "$WATCH_LIST"
	[ -x /etc/init.d/oxidnsplus ] && /etc/init.d/oxidnsplus restart >/dev/null 2>&1 || true
	printf '{"ok":true}\n'
}

emit_log() {
	INPUT="$(cat)"
	n="$(input_value lines "$INPUT")"
	case "$n" in ''|*[!0-9]*) n=100;; esac
	[ "$n" -le 500 ] 2>/dev/null || n=500
	printf '{"ok":true,"lines":'
	json_string "$(logread -e '\[prewarmer\]' 2>/dev/null | tail -n "$n")"
	printf '}\n'
}

# dispatcher
case "${1:-}" in
	list)
		printf '{'
		printf '"status":{},'
		printf '"settings_read":{},'
		printf '"settings_save":{'
		first=1
		for f in $FIELDS; do
			[ $first -eq 1 ] || printf ','
			first=0
			printf '"%s":"string"' "$f"
		done
		printf '},'
		printf '"warm_list_read":{},'
		printf '"warm_list_save":{"content":"string"},'
		printf '"log":{"lines":"string"}'
		printf '}\n'
		;;
	call)
		case "${2:-}" in
			status) emit_status ;;
			settings_read) emit_settings_read ;;
			settings_save) emit_settings_save ;;
			warm_list_read) emit_warm_list_read ;;
			warm_list_save) emit_warm_list_save ;;
			log) emit_log ;;
			*) printf '{"ok":false,"error":"unknown method"}\n'; exit 1 ;;
		esac
		;;
	*)
		printf '{"ok":false,"error":"usage: luci.oxidnsplus list|call <method>"}\n'
		exit 1
		;;
esac
