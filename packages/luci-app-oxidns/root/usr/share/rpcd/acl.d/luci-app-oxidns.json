{
	"luci-app-oxidns": {
		"description": "Grant access to the OxiDNS LuCI app",
		"read": {
			"ubus": {
				"luci.oxidns": [
					"status",
					"core_progress",
					"core_update_check",
					"config_read",
					"settings_read",
					"logs_recent",
					"rules_status",
					"rules_check",
					"cache_suggest",
					"cache_detail",
					"upstreams",
					"probe_upstreams",
					"zone_info",
					"trace_route"
				]
			}
		},
		"write": {
			"cgi-io": [ "upload" ],
			"file": {
				"/tmp/oxidns-core-upload-*": [ "write" ]
			},
			"ubus": {
				"luci.oxidns": [
					"core_install",
					"core_reinstall",
					"core_update",
					"core_upload_install",
					"core_remove",
					"service_start",
					"service_stop",
					"service_restart",
					"service_enable",
					"service_disable",
					"config_validate",
					"config_save",
					"settings_save",
					"rules_update",
					"rules_restore"
				]
			}
		}
	}
}
