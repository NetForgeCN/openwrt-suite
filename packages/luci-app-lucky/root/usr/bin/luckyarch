#!/bin/sh

# Keep this map aligned with the LUCKY_ARCH branches in lucky/Makefile. The
# dashboard only needs to report the variant that was actually bundled into
# the firmware; guessing from CPU features (or from hexdump byte order) used
# to report a core that is not present in the image.
arch="$(uname -m)"
case "$arch" in
	x86_64|amd64)
		cpucore="x86_64"
		;;
	i*86)
		cpucore="i386"
		;;
	aarch64*|armv8*)
		cpucore="arm64"
		;;
	armv7*)
		cpucore="armv7"
		;;
	arm*)
		# Makefile uses CPU_TYPE=cortex to select armv7; /proc/cpuinfo is the
		# closest runtime equivalent. Everything else stays on the armv5 pin.
		if grep -qi 'cortex' /proc/cpuinfo 2>/dev/null; then
			cpucore="armv7"
		else
			cpucore="armv5"
		fi
		;;
	mips64*)
		cpucore="mips64_softfloat"
		;;
	mipsel*)
		cpucore="mipsle_softfloat"
		;;
	mips*)
		cpucore="mips_softfloat"
		;;
	riscv64*)
		cpucore="riscv64"
		;;
	*)
		cpucore="$arch"
		;;
esac

printf '%s\n' "$cpucore"
