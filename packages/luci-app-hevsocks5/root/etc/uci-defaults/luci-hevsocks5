#!/bin/sh
# Initial UCI defaults for luci-app-hevsocks5.
# Keeps the upstream enabled/conffile options intact and fills in every
# option exposed by the LuCI page.

CONF='hev-socks5-server'
RC=0

uci -q get "$CONF.config" >/dev/null 2>&1 || uci set "$CONF.config=hev-socks5-server" || RC=1

set_default() {
	uci -q get "$CONF.config.$1" >/dev/null 2>&1 && return 0
	uci set "$CONF.config.$1=$2" || {
		echo "luci-hevsocks5: failed to set $1" >&2
		RC=1
	}
}

set_default enabled 0
set_default conffile /etc/hev-socks5-server/main.yml

set_default workers 4
set_default port 1080
set_default listen_address '::'
set_default udp_port ''
set_default udp_listen_address ''
set_default udp_public_address_v4 ''
set_default udp_public_address_v6 ''
set_default listen_ipv6_only 0
set_default bind_address ''
set_default bind_address_v4 ''
set_default bind_address_v6 ''
set_default bind_interface ''
set_default domain_address_type unspec
set_default mark 0
set_default tcp_fastopen 0

set_default auth_file ''
set_default allow_no_auth 0
set_default username ''
set_default password ''

set_default task_stack_size 8192
set_default udp_recv_buffer_size 524288
set_default udp_copy_buffer_nums 10
set_default connect_timeout 10000
set_default tcp_read_write_timeout 300000
set_default udp_read_write_timeout 60000
set_default read_write_timeout ''
set_default log_file ''
set_default log_level warn
set_default pid_file ''
set_default limit_nofile 1000000

# Generate one random credential pair on first install. Without it the
# server would start as an open proxy, which is never a safe default.
# Use the same CSPRNG-backed helper as the LuCI page, with a byte-wise
# fallback for systems where it is not available yet.
gen_credential() {
	local len="$1" value

	value="$(/usr/bin/hevsocks5-ctl rand "$len" 2>/dev/null)" || value=''
	[ "${#value}" -eq "$len" ] || value="$(head -c "$len" /dev/urandom | od -An -tx1 | tr -d ' \n' | cut -c1-"$len")"
	[ "${#value}" -eq "$len" ] || return 1
	printf '%s' "$value"
}

if [ -z "$(uci -q get "$CONF.config.username" 2>/dev/null)" ] &&
	[ -z "$(uci -q get "$CONF.config.password" 2>/dev/null)" ] &&
	[ "$(uci -q get "$CONF.config.allow_no_auth" 2>/dev/null)" != "1" ]; then
	u="$(gen_credential 16)" || RC=1
	p="$(gen_credential 24)" || RC=1
	if [ -n "$u" ] && [ -n "$p" ]; then
		uci set "$CONF.config.username=$u" || RC=1
		uci set "$CONF.config.password=$p" || RC=1
	else
		echo "luci-hevsocks5: failed to generate initial credentials" >&2
		RC=1
	fi
fi

uci commit "$CONF" >/dev/null 2>&1 || RC=1
/usr/bin/hevsocks5-ctl generate >/dev/null 2>&1 || {
	echo "luci-hevsocks5: initial YAML generation failed" >&2
	RC=1
}

exit "$RC"
