config settings 'main'
	option core_repository 'svenshi/oxidns'
	option core_bundle 'full'
	option config_path '/etc/oxidns/config.yaml'
	option working_dir '/var/lib/oxidns'
	option log_syslog '1'
	option persist_core '1'
	option github_token ''
	option download_proxy ''
	# API 密码：配置里写 ${OXIDNS_API_PASS} 时，两处脚本从这里取值注入环境。
	# 留空 = 不注入，oxidns 会因变量未定义而启动/检查失败（fail closed）。
	option api_pass ''
