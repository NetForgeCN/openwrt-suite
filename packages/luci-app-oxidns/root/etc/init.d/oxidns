#!/bin/sh /etc/rc.common

USE_PROCD=1
START=90
STOP=10

PROG="/usr/bin/oxidns"
DEFAULT_CONFIG_PATH="/etc/oxidns/config.yaml"
DEFAULT_WORKING_DIR="/var/lib/oxidns"
PERSIST_DIR="/etc/oxidns/core"
PERSIST_BIN="$PERSIST_DIR/oxidns"
PERSIST_WEBUI="$PERSIST_DIR/webui"
WEBUI_DIR="/usr/share/oxidns/webui"
RULES_DIR="/etc/oxidns/rules"
RULES_BASELINE_DIR="/usr/share/oxidns/rules-baseline"
# force-cn/force-abroad are hand-maintained policy lists shipped by the
# baseline package (not part of the subscription archive); the Rules page
# re-seeds them from the baseline after its whole-directory swap.
RULE_FILES="adguard-antiad.txt adguard-hostlist.txt anti-ad-domains.txt adrules-domains.txt neodevhost-domains.txt accelerated-domains.china.conf cn-domains.txt force-cn.txt force-abroad.txt"

load_oxidns_settings() {
	config_load oxidns
	config_get CONFIG_PATH main config_path "$DEFAULT_CONFIG_PATH"
	config_get WORKING_DIR main working_dir "$DEFAULT_WORKING_DIR"
	config_get_bool LOG_SYSLOG main log_syslog 1
	config_get API_PASS main api_pass ""
}

# Boot self-heal: the persistent copy of the core survives firmware upgrades
# (via /etc/sysupgrade.conf). Recreate the runtime symlinks when they are
# missing or dangling, so a reinstall of the LuCI package after an upgrade is
# enough to bring the DNS service back without re-downloading anything.
restore_core_links() {
	if [ -x "$PERSIST_BIN" ]; then
		if [ ! -x "$PROG" ]; then
			mkdir -p "$(dirname "$PROG")"
			ln -sf "$PERSIST_BIN" "$PROG"
		fi
	fi
	if [ -d "$PERSIST_WEBUI" ]; then
		if [ ! -d "$WEBUI_DIR" ]; then
			mkdir -p "$(dirname "$WEBUI_DIR")"
			ln -sfn "$PERSIST_WEBUI" "$WEBUI_DIR"
		fi
	fi
}

# Boot self-heal for rule subscriptions. File-backed providers (domain_set,
# adguard_rule) abort the whole process when a rule file is missing, and every
# download/convert path runs *after* plugin initialisation, so OxiDNS can never
# repair this itself. Seed missing files from the bundled baseline package
# instead: local copy, no network, no boot delay.
seed_rule_files() {
	mkdir -p "$RULES_DIR" 2>/dev/null || true
	if [ -d "$RULES_BASELINE_DIR" ]; then
		for rule_file in $RULE_FILES; do
			[ -s "$RULES_DIR/$rule_file" ] && continue
			[ -s "$RULES_BASELINE_DIR/$rule_file" ] || continue
			if cp "$RULES_BASELINE_DIR/$rule_file" "$RULES_DIR/$rule_file"; then
				logger -t oxidns "seeded $rule_file from rules baseline"
			fi
		done
		if [ ! -s "$RULES_DIR/.installed-version" ] && [ -s "$RULES_BASELINE_DIR/VERSION" ]; then
			cp "$RULES_BASELINE_DIR/VERSION" "$RULES_DIR/.installed-version" 2>/dev/null
		fi
	else
		logger -t oxidns -p daemon.warn \
			"rules baseline not installed ($RULES_BASELINE_DIR); cannot seed rule files"
	fi

	# Report the files that are still missing instead of letting OxiDNS die with
	# a bare "failed to open text source" line that says nothing about the cause.
	missing_rules=""
	for rule_file in $RULE_FILES; do
		[ -s "$RULES_DIR/$rule_file" ] || missing_rules="$missing_rules $rule_file"
	done
	if [ -n "$missing_rules" ]; then
		logger -t oxidns -p daemon.err "missing rule files:$missing_rules"
		echo "oxidns: missing rule files:$missing_rules (install oxidns-rules-baseline)" >&2
	fi
	return 0
}

start_service() {
	load_oxidns_settings
	restore_core_links
	seed_rule_files

	if [ ! -x "$PROG" ]; then
		echo "oxidns binary not found or not executable: $PROG" >&2
		return 1
	fi
	if [ ! -r "$CONFIG_PATH" ]; then
		echo "oxidns config not found: $CONFIG_PATH" >&2
		return 1
	fi

	mkdir -p "$WORKING_DIR"

	procd_open_instance
	procd_set_param command "$PROG" start -c "$CONFIG_PATH" -d "$WORKING_DIR"
	# [API password] The config uses ${OXIDNS_API_PASS}. procd only passes env
	# vars explicitly declared here; inject the UCI value so the service
	# process can expand it. Empty value is left unset on purpose (fail closed).
	if [ -n "$API_PASS" ]; then
		procd_set_param env OXIDNS_API_PASS="$API_PASS"
	fi
	procd_set_param respawn 3600 5 5
	procd_set_param stdout "$LOG_SYSLOG"
	procd_set_param stderr "$LOG_SYSLOG"
	procd_close_instance
}

reload_service() {
	procd_send_signal oxidns
}

service_triggers() {
	procd_add_reload_trigger oxidns
}
