config main 'main'
	# Master switch.
	option enabled '1'

	# OxiDNS main config path (read-only; used to derive API base + username).
	option config_path '/etc/oxidns/config.yaml'
	option api_base ''
	option api_user ''
	# If config.yaml uses ${OXIDNS_API_PASS}, put the same value here (or export
	# it in the environment). Leave empty if the API runs without auth.
	option api_pass ''

	# Cache plugin tag and the local DNS listener the probe query targets.
	option cache_tag 'cache_main'
	option dns_target '127.0.0.1:5333'

	# Watch list + scheduling mode: list (only watch.list) or all (all cached).
	option watch_list '/etc/oxidnsplus/watch.list'
	option mode 'list'

	# Scheduler timing.
	option tick '5'
	# Probes fire GRACE seconds AFTER fresh TTL expiry (into the stale window),
	# so OxiDNS's native lazy cache performs the actual background refresh.
	option grace '3'
	option refresh_delay '1200'
	option min_ttl '30'
	option min_interval '10'
	option max_interval '3600'
	option jitter '5'
	option retry_base '15'
	option retry_max '300'
	option retry_max_count '8'
	option log_level 'info'
