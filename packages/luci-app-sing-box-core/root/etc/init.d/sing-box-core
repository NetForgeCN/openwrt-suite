#!/bin/sh /etc/rc.common
# /etc/init.d/sing-box-core
#
# 与系统 sing-box 包完全独立：不同的二进制、不同的配置、不同的服务名。
# 两者可以同时安装，互不干扰。

START=99
STOP=10
USE_PROCD=1

PROG=/usr/libexec/sing-box-core/sing-box
CONF=/var/run/sing-box-core/config.json

start_service() {
	local enabled

	config_load singbox_core
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0

	mkdir -p /var/run/sing-box-core /etc/sing-box-core

	# 运行配置不存在时先生成一份，避免首次启动直接失败
	[ -f "$CONF" ] || /usr/libexec/sing-box-core/render.uc || return 1

	procd_open_instance
	procd_set_param command "$PROG" run -c "$CONF"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	/usr/libexec/sing-box-core/apply.sh
}

stop_service() {
	local table

	config_load singbox_core
	config_get table route tun_table 2023

	# 给进程一点时间自己清理；正常退出时 sing-box 会回收 TUN 和 ip rule
	sleep 1

	ip link show sbc-tun >/dev/null 2>&1 && ip link del sbc-tun 2>/dev/null
	while ip rule del table "$table" 2>/dev/null; do :; done
	ip route flush table "$table" 2>/dev/null

	# auto_redirect 建的 nft 表，表名带 sing 前缀
	for t in $(nft list tables 2>/dev/null | awk '/inet/ && /sing/ {print $3}'); do
		nft delete table inet "$t" 2>/dev/null
	done
}

service_triggers() {
	procd_add_reload_trigger singbox_core
}
