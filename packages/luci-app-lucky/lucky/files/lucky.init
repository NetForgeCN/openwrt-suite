#!/bin/sh /etc/rc.common

START=99
STOP=15
USE_PROCD=1

PROG=/usr/bin/lucky
DEFAULT_CONFDIR=/etc/config/lucky.daji

# The config directory reaches the core as an argv element (procd does not
# invoke a shell), but it still decides where the core writes its state. Keep
# it a simple absolute path: no parent traversal, no shell metacharacters and
# no whitespace/control characters.
valid_confdir() {
	local dir="$1"

	[ -n "$dir" ] || return 1
	case "$dir" in
		/*) ;;
		*) return 1 ;;
	esac
	case "$dir" in
		*..*) return 1 ;;
	esac
	case "$dir" in
		*[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789/._-]*) return 1 ;;
	esac
	return 0
}

get_config() {
	config_get_bool enabled "$1" enabled 0
	config_get_bool log_enable "$1" logger 1
	config_get CONFDIR "$1" configdir "$DEFAULT_CONFDIR"
}

start_service() {
	local enabled=1
	local log_enable=1
	local CONFDIR="$DEFAULT_CONFDIR"

	if [ ! -x "$PROG" ]; then
		logger -t lucky -p daemon.err "Lucky core binary not found: $PROG"
		return 1
	fi

	if [ -s /etc/config/lucky ]; then
		config_load lucky || {
			logger -t lucky -p daemon.err "Unable to load /etc/config/lucky"
			return 1
		}
		config_foreach get_config lucky
	fi

	[ "$enabled" -eq 1 ] || return 0

	if ! valid_confdir "$CONFDIR"; then
		logger -t lucky -p daemon.warn "Invalid config directory '$CONFDIR'; using $DEFAULT_CONFDIR"
		CONFDIR="$DEFAULT_CONFDIR"
	fi

	# Do not let a pre-existing symlink redirect Lucky's writes elsewhere.
	if [ -L "$CONFDIR" ]; then
		logger -t lucky -p daemon.warn "Config directory is a symlink: $CONFDIR; using $DEFAULT_CONFDIR"
		CONFDIR="$DEFAULT_CONFDIR"
	fi

	[ -d "$CONFDIR" ] || mkdir -p "$CONFDIR" 2>/dev/null || {
		logger -t lucky -p daemon.err "Unable to create config directory: $CONFDIR"
		return 1
	}

	procd_open_instance "lucky"
	procd_set_param command "$PROG" -cd "$CONFDIR"
	procd_set_param respawn
	procd_set_param stdout "$log_enable"
	procd_set_param stderr "$log_enable"
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "lucky"
}
